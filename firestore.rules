rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity helpers
    // ---------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role lives in the auth token as a custom claim, not in a Firestore
    // document. Two reasons:
    //   1. A claim cannot be written by the client at all, so `role` stops being
    //      something the rules have to defend with a write guard.
    //   2. It costs zero document reads, where the old get(users/$(uid)) cost
    //      one extra read on every single rule evaluation.
    // Claims are set by scripts/grant-coach.js (Admin SDK). A user picks up a
    // new claim on their next sign-in or token refresh.
    function isTeacher() {
      return isAuthenticated() && request.auth.token.get('role', 'student') in ['teacher', 'coach'];
    }

    // Class ids this coach is assigned to, carried in the same claim.
    function myClassIds() {
      return request.auth.token.get('classIds', []);
    }

    // Tenancy check against a user document that is already loaded as
    // `resource` - i.e. rules on /users/{userId} itself.
    //
    // This must NOT be done with get() on /users/$(userId): during a `list`
    // operation that is a read of the very document being evaluated, and the
    // query is rejected with "Null value error". It also happens to be free,
    // where the get() form costs a document read per candidate row.
    function coachSharesClassWith(userData) {
      return isTeacher() && userData.get('classIds', []).hasAny(myClassIds());
    }

    // Tenancy check from the learner's perspective: does the learner share at least one
    // class with a given coach?
    function learnerHasClassWithCoach(coachId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(coachId))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('classIds', []).hasAny(get(/databases/$(database)/documents/users/$(coachId)).data.get('classIds', []));
    }

    // Same check for SUBcollection rules, where the parent user document is not
    // `resource` and genuinely has to be fetched. Costs one document read, and
    // is only ever paid on coach-initiated access.
    function isCoachOf(userId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId))
             .data.get('classIds', []).hasAny(myClassIds());
    }

    // A join code the learner typed, resolved through classCodes/{CODE}.
    //
    // This is what makes client-side enrolment safe without a backend. The
    // client cannot simply assert "add me to class X": the rule re-reads the
    // code document itself and checks it really maps to the class being joined.
    // A learner who does not know a valid code cannot produce one, and guessing
    // a classId directly fails because there is no matching code.
    function codeClassId() {
      return get(/databases/$(database)/documents/classCodes/$(request.resource.data.enrolledVia)).data.classId;
    }

    /**
     * True for exactly one safe operation: a learner adding themselves to the
     * single class their join code names, touching nothing else.
     *
     * `role` is explicitly pinned rather than merely absent from the changed
     * keys, so this path can never become a privilege escalation.
     */
    function isSelfEnrolment() {
      let before = resource.data.get('classIds', []);
      let after = request.resource.data.get('classIds', []);
      let code = request.resource.data.get('enrolledVia', '');

      return code is string
        && code.size() > 0
        && exists(/databases/$(database)/documents/classCodes/$(code))
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['classIds', 'groupName', 'enrolledVia', 'updatedAt'])
        && after.hasAll(before)
        && after.hasAny([codeClassId()])
        && after.hasOnly(before.concat([codeClassId()]));
    }

    function teachesClass(classId) {
      return isTeacher() && myClassIds().hasAny([classId]);
    }

    function inClass(classId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('classIds', []).hasAny([classId]);
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Phase 0 Admin & Reference collections (API only, client read/write false)
    // ---------------------------------------------------------------------
    match /organizations/{docId} { allow read, write: if false; }
    match /schools/{docId} { allow read, write: if false; }
    match /cohorts/{docId} { allow read, write: if false; }
    match /programmes/{docId} { allow read, write: if false; }
    match /publicIds/{docId} { allow read, write: if false; }
    match /parentLinks/{docId} { allow read, write: if false; }
    match /parentInvites/{docId} { allow read, write: if false; }

    // ---------------------------------------------------------------------
    // Canva Connect Integration (Server Admin SDK only, client read/write false)
    // ---------------------------------------------------------------------
    match /canvaConnections/{userId} { allow read, write: if false; }
    match /canvaOAuthStates/{stateId} { allow read, write: if false; }

    // ---------------------------------------------------------------------
    // Join codes. classCodes/{CODE} -> { classId, className, createdBy, createdAt }
    //
    // Readable one document at a time by exact code, which is what a learner
    // typing a code does. Listing is denied outright: without that, a single
    // query would hand any signed-in learner every code for every class in
    // every school, which is the whole secret this collection holds.
    //
    // A coach may issue and revoke codes for the classes they teach, and only
    // those. Issuing must happen in the same write as pointing the class's
    // `joinCode` at the new code, so the code a coach sees on the class is
    // always one that really works. Codes are never updated: a code that
    // already exists cannot be taken over by writing it again, and rotating
    // is revoke + issue. Admin tooling (scripts/class-codes.js) bypasses this.
    // ---------------------------------------------------------------------
    function isWellFormedCode(code) {
      return code.matches('^[BCDFGHJKMNPQRSTVWXYZ2-9]{4}-[BCDFGHJKMNPQRSTVWXYZ2-9]{4}$');
    }

    match /classCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if teachesClass(request.resource.data.classId)
        && isWellFormedCode(code)
        && request.resource.data.keys().hasOnly(['classId', 'className', 'createdBy', 'createdAt'])
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 120
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.get('joinCode', null) == code;
      allow update: if false;
      // Revoking also clears the class's joinCode in the same write, so a
      // class never advertises a code that no longer works.
      allow delete: if teachesClass(resource.data.classId)
        && getAfter(/databases/$(database)/documents/classes/$(resource.data.classId)).data.get('joinCode', null) != code;
    }

    // ---------------------------------------------------------------------
    // Classes - the tenancy unit. Created and owned by coaches.
    // ---------------------------------------------------------------------
    // `joinCode` and `programId` are what coaches change from the dashboard.
    // joinCode may only ever name a code that (after this write) exists and
    // belongs to this class, or be cleared; programId is a short string or null.
    function classFieldsValid(classId) {
      let code = request.resource.data.get('joinCode', null);
      let program = request.resource.data.get('programId', null);
      return (code == null
          || (code is string
              && existsAfter(/databases/$(database)/documents/classCodes/$(code))
              && getAfter(/databases/$(database)/documents/classCodes/$(code)).data.classId == classId))
        && (program == null || (program is string && program.size() > 0 && program.size() <= 100));
    }

    match /classes/{classId} {
      allow read: if teachesClass(classId) || inClass(classId);
      allow create: if isTeacher() && request.resource.data.coachIds.hasAny([request.auth.uid])
        && request.resource.data.get('joinCode', null) == null;
      allow update: if teachesClass(classId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['joinCode', 'programId'])
            || classFieldsValid(classId));
      allow delete: if teachesClass(classId);
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('role', 'student') == 'admin';
    }

    function isAdminOrSupervisor() {
      return isAuthenticated() && request.auth.token.get('role', 'student') in ['admin', 'supervisor'];
    }

    // ---------------------------------------------------------------------
    // User profiles
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Reads are limited to the owner, admin/supervisor, and to coaches who share a class with that student.
      // NOTE for queries: a coach listing students MUST constrain the query,
      // e.g. .where('classIds', 'array-contains-any', myClassIds) - an
      // unconstrained collection read is rejected in full.
      allow read: if isOwner(userId) || isAdminOrSupervisor() || coachSharesClassWith(resource.data);

      // New accounts are always learners/students. Coach access is granted out-of-band
      // with the Admin SDK (scripts/grant-coach.js), which bypasses these rules.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'student') in ['student', 'learner'];

      // `role` may never be self-assigned or changed - it is the privilege boundary.
      // `classIds` is the tenancy boundary and is equally closed, with one
      // narrow exception: a learner may add themselves to a class whose join
      // code they can produce.
      //
      // Coaches who teach the student may update ONLY activeProgramId and updatedAt
      // when assigning or publishing a program to that learner.
      allow update: if (
        isOwner(userId)
        && request.resource.data.get('role', resource.data.get('role', 'student')) == resource.data.get('role', 'student')
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'orgId', 'schoolIds', 'classIds', 'status', 'publicId', 'consent', 'enrolledVia'])
          || isSelfEnrolment()
        )
      ) || (
        isCoachOf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activeProgramId', 'updatedAt'])
      );
      allow delete: if isOwner(userId);

      match /notes/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /progress/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /dailyStats/{docId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /activityProgress/{docId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /activityPreferences/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Coach-authored ratings on a student's work.
      match /ratings/{ratingId} {
        allow read: if isOwner(userId) || isCoachOf(userId) || isAdminOrSupervisor();
        allow create, update, delete: if isCoachOf(userId);
      }

      // Coach-authored feedback on student work.
      match /feedback/{feedbackId} {
        allow read: if isOwner(userId) || isCoachOf(userId) || isAdminOrSupervisor();
        allow create, update, delete: if isCoachOf(userId);
      }

      // Coach notifications to students.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, delete, update: if isAuthenticated();
      }

      // Conversations between a child and the AI tutor.
      match /aiConversations/{messageId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Coach-authored coursework, scoped to a class
    // ---------------------------------------------------------------------

    match /weeklyTasks/{taskId} {
      allow read: if teachesClass(resource.data.classId) || inClass(resource.data.classId);
      allow create: if isTeacher() && teachesClass(request.resource.data.classId);
      allow update, delete: if isTeacher() && teachesClass(resource.data.classId);
    }

    match /assignments/{assignmentId} {
      allow read: if teachesClass(resource.data.classId) || inClass(resource.data.classId);
      allow create: if isTeacher() && teachesClass(request.resource.data.classId);
      allow update, delete: if isTeacher() && teachesClass(resource.data.classId);
    }

    // ---------------------------------------------------------------------
    // PBL Programs (Authoring & Publishing)
    // ---------------------------------------------------------------------
    match /pbl_programs/{programId} {
      // Coaches and admins can read any program (including drafts).
      // Learners can read published programs that are visible centre-wide,
      // where the coach shares a class, or where the learner is enrolled / in the assigned class.
      allow read: if isTeacher()
        || isAdminOrSupervisor()
        || (
          isAuthenticated()
          && resource.data.get('status', 'published') == 'published'
          && (
            resource.data.get('visibility', 'centre') == 'centre'
            || exists(/databases/$(database)/documents/enrolments/$(request.auth.uid + '_' + programId))
            || (('classId' in resource.data) && inClass(resource.data.classId))
            || (('authorId' in resource.data) && learnerHasClassWithCoach(resource.data.authorId))
            || (('authorUid' in resource.data) && learnerHasClassWithCoach(resource.data.authorUid))
          )
        );
      // Teachers/coaches can create and update programs
      allow create: if isTeacher()
        && (
          request.resource.data.get('authorId', request.resource.data.get('authorUid', request.auth.uid)) == request.auth.uid
          || isTeacher()
        );
      allow update: if isTeacher();
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Frameworks (WeLearn Design Thinking framework single source of truth)
    // ---------------------------------------------------------------------
    match /frameworks/{frameworkId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher() || isAdminOrSupervisor();
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Enrolments & Phase Progress
    // Document ID format: {learnerUid}_{programId}
    // ---------------------------------------------------------------------
    function isValidEnrolmentStatus(status) {
      return status in ['active', 'completed', 'dropped'];
    }

    match /enrolments/{enrolmentId} {
      // Read: learner owns it or coach of learner
      allow read: if isAuthenticated() && (
        resource.data.learnerId == request.auth.uid
        || isCoachOf(resource.data.learnerId)
        || isAdminOrSupervisor()
      );

      // Create: learner self-enrolls or coach assigns to learner in coach's class
      allow create: if isAuthenticated() && (
        (
          request.resource.data.learnerId == request.auth.uid
          && enrolmentId == request.auth.uid + '_' + request.resource.data.programId
          && isValidEnrolmentStatus(request.resource.data.get('status', 'active'))
        )
        ||
        (
          isTeacher()
          && (isCoachOf(request.resource.data.learnerId) || (('classId' in request.resource.data) && request.resource.data.classId != null && teachesClass(request.resource.data.classId)))
          && enrolmentId == request.resource.data.learnerId + '_' + request.resource.data.programId
          && isValidEnrolmentStatus(request.resource.data.get('status', 'active'))
        )
      );

      // Update: learner can update own enrolment fields (status, currentPhaseId, updatedAt); coach can update
      allow update: if isAuthenticated() && (
        (
          resource.data.learnerId == request.auth.uid
          && request.resource.data.learnerId == request.auth.uid
          && request.resource.data.programId == resource.data.programId
          && request.resource.data.get('source', '') == resource.data.get('source', '')
          && isValidEnrolmentStatus(request.resource.data.get('status', resource.data.status))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'currentPhaseId', 'updatedAt'])
        )
        ||
        (
          isTeacher()
          && (isCoachOf(resource.data.learnerId) || (('classId' in resource.data) && resource.data.classId != null && teachesClass(resource.data.classId)))
          && request.resource.data.learnerId == resource.data.learnerId
          && request.resource.data.programId == resource.data.programId
          && isValidEnrolmentStatus(request.resource.data.get('status', resource.data.status))
        )
      );

      allow delete: if false;

      // Subcollection: phaseProgress
      match /phaseProgress/{phaseId} {
        allow read: if isAuthenticated() && (
          (
            exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
            && (
              get(/databases/$(database)/documents/enrolments/$(enrolmentId)).data.learnerId == request.auth.uid
              || isCoachOf(get(/databases/$(database)/documents/enrolments/$(enrolmentId)).data.learnerId)
            )
          )
          ||
          (
            !exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
            && enrolmentId.matches('^' + request.auth.uid + '_.*')
          )
          || isAdminOrSupervisor()
        );

        allow create: if isAuthenticated() && (
          // Learner creating/initializing phase progress
          (
            (
              (
                exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
                && get(/databases/$(database)/documents/enrolments/$(enrolmentId)).data.learnerId == request.auth.uid
              )
              ||
              (
                !exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
                && enrolmentId.matches('^' + request.auth.uid + '_.*')
              )
            )
            && !('coachFeedback' in request.resource.data)
            && request.resource.data.get('status', 'in_progress') in ['not_started', 'in_progress', 'submitted']
          )
          ||
          // Coach creating/initializing phase progress (only if enrolment doc exists and coach teaches learner)
          (
            isTeacher()
            && exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
            && isCoachOf(get(/databases/$(database)/documents/enrolments/$(enrolmentId)).data.learnerId)
          )
        );

        allow update: if isAuthenticated() && (
          // Learner update: allowed ONLY for evidence & learner fields, MUST NOT touch coachFeedback,
          // and CANNOT set status == 'reviewed'
          (
            (
              (
                exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
                && get(/databases/$(database)/documents/enrolments/$(enrolmentId)).data.learnerId == request.auth.uid
              )
              ||
              (
                !exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
                && enrolmentId.matches('^' + request.auth.uid + '_.*')
              )
            )
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coachFeedback'])
            && request.resource.data.get('status', '') != 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'evidence', 'updatedAt', 'notes', 'reflection', 'deliverables'])
          )
          ||
          // Coach update (P1 & P2): coaches can only update coachFeedback, status, and updatedAt
          (
            isTeacher()
            && exists(/databases/$(database)/documents/enrolments/$(enrolmentId))
            && isCoachOf(get(/databases/$(database)/documents/enrolments/$(enrolmentId)).data.learnerId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['coachFeedback', 'status', 'updatedAt'])
          )
        );

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Sessions (Time Tracking & Activity Heartbeats)
    // ---------------------------------------------------------------------
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid
        || isCoachOf(resource.data.uid)
        || isAdminOrSupervisor()
      );
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Student work
    // ---------------------------------------------------------------------
    match /solarCar_prototypes/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /simulations/{simulationId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.modelVersion is string
        && request.resource.data.baselineDate is string;
      allow update, delete: if false;
    }

    match /simulationResults/{resultId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      // Two shapes: v1.0 kinetic runs (many points per simulations/ doc) and
      // v1.1 filter runs (one document per simulationRuns/ doc, same id).
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          (request.resource.data.get('kind', '') != 'filterRun'
            && getAfter(/databases/$(database)/documents/simulations/$(request.resource.data.simulationId))
                 .data.userId == request.auth.uid)
          || (request.resource.data.get('kind', '') == 'filterRun'
            && resultId == request.resource.data.runId
            && get(/databases/$(database)/documents/simulationRuns/$(resultId)).data.userId == request.auth.uid)
        );
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Simulation economy (Activity 6 filter lab, SIM-COST-v1.0).
    //
    // Credits are virtual, but they are only meaningful if a learner cannot
    // mint them. There is no backend in production, so these rules are the
    // authority:
    //   - every cost is recomputed here from this price table and the
    //     multiplier tiers (src/features/activities/so2Sulfate/filter/pricing.js
    //     holds the same table; tests/sim-economy.test.js checks they match);
    //   - every ledger row is tied to exactly one budget change by a sequence
    //     number, and balanceAfter must equal balanceBefore - cost, >= 0;
    //   - the ledger is append-only and the budget cannot be deleted;
    //   - a budget can only be topped up by a reset to a preset, at most once
    //     per 24 h, and the two large presets are staff-only.
    // What a client can still do is under-declare which multiplier tier it
    // used. Every multiplier is >= 1, so no action can cost less than its base
    // price, and runs are checked against their own stored settings.
    // ---------------------------------------------------------------------
    function simPrices() {
      return {
        'START_SIMULATION': 25, 'RESET_SIMULATION': 10, 'STEP_MODE': 5,
        'FAST_FORWARD': 15, 'HIGH_RESOLUTION_SIMULATION': 50,
        'NANOPARTICLE_VIEW': 20, 'ACTIVE_SITE_VIEW': 35,
        'MOLECULAR_TRAJECTORY_TRACKING': 40, 'ADD_100_AU_NANOPARTICLES': 75,
        'INCREASE_PARTICLE_RESOLUTION': 100, 'DOUBLE_PARTICLE_COUNT': 150,
        'TEMPERATURE_SWEEP': 200, 'SO2_CONCENTRATION_SWEEP': 200,
        'FLOW_RATE_SWEEP': 175, 'CATALYST_LOADING_SWEEP': 250,
        'FULL_PARAMETER_SWEEP': 750, 'CATALYST_COMPARISON': 25,
        'GENERATE_PERFORMANCE_GRAPH': 15, 'GENERATE_DETAILED_REPORT': 50,
        'EXPORT_DATA': 25, 'EXPORT_HIGH_RES_GRAPHICS': 40,
        'SAVE_SIMULATION': 5, 'LOAD_SAVED_SIMULATION': 5
      };
    }

    // Which multipliers each action may use. Anything not listed must be 1.
    function simScales() {
      return {
        'START_SIMULATION': ['resolution', 'particles', 'time', 'nanoparticles'],
        'STEP_MODE': ['resolution', 'particles'],
        'FAST_FORWARD': ['resolution', 'particles'],
        'HIGH_RESOLUTION_SIMULATION': ['particles'],
        'NANOPARTICLE_VIEW': ['nanoparticles'],
        'MOLECULAR_TRAJECTORY_TRACKING': ['resolution'],
        'TEMPERATURE_SWEEP': ['resolution'], 'SO2_CONCENTRATION_SWEEP': ['resolution'],
        'FLOW_RATE_SWEEP': ['resolution'], 'CATALYST_LOADING_SWEEP': ['resolution'],
        'FULL_PARAMETER_SWEEP': ['resolution'], 'CATALYST_COMPARISON': ['resolution']
      };
    }

    function simPresets() {
      return { 'STUDENT': 1000, 'RESEARCHER': 10000, 'ADVANCED': 50000, 'INSTITUTION': 250000 };
    }

    function simResolutionTiers() { return { 'standard': 1, 'high': 2 }; }
    function simParticleTiers() { return { '200': 1, '400': 1.5, '800': 2, '1600': 2.5, '3200': 3 }; }
    function simNanoparticleTiers() {
      return { '100': 1, '200': 1.25, '300': 1.5, '400': 1.75, '500': 2,
               '600': 2.25, '700': 2.5, '800': 2.75, '900': 3, '1000': 3.25 };
    }

    function isStaff() {
      return isAuthenticated()
        && request.auth.token.get('role', 'student') in ['teacher', 'coach', 'admin', 'supervisor'];
    }

    function presetAllowed(preset) {
      return preset in simPresets()
        && (preset in ['STUDENT', 'RESEARCHER'] || isStaff());
    }

    function scales(action, name) {
      return action in simScales() && simScales()[action].hasAny([name]);
    }

    function budgetPath(uid) {
      return /databases/$(database)/documents/budgets/$(uid);
    }

    function txPath(txId) {
      return /databases/$(database)/documents/transactions/$(txId);
    }

    // A paid action. The budget before (get) and after (getAfter) this write
    // must differ by exactly this row.
    function validCharge(d, before, after) {
      return d.action in simPrices()
        && d.baseCost == simPrices()[d.action]
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 500
        && d.resolutionMultiplier in [1, 2]
        && d.particleMultiplier in [1, 1.5, 2, 2.5, 3]
        && d.timeMultiplier is int && d.timeMultiplier >= 1 && d.timeMultiplier <= 30
        && d.nanoparticleMultiplier in [1, 1.25, 1.5, 1.75, 2, 2.25, 2.5, 2.75, 3, 3.25]
        && (d.resolutionMultiplier == 1 || scales(d.action, 'resolution'))
        && (d.particleMultiplier == 1 || scales(d.action, 'particles'))
        && (d.timeMultiplier == 1 || scales(d.action, 'time'))
        && (d.nanoparticleMultiplier == 1 || scales(d.action, 'nanoparticles'))
        && d.units == d.quantity * d.resolutionMultiplier * d.particleMultiplier
                      * d.timeMultiplier * d.nanoparticleMultiplier
        && d.cost is int
        && d.cost == math.ceil(d.baseCost * d.units)
        && d.balanceAfter == before.balance - d.cost
        && d.balanceAfter >= 0
        && after.balance == d.balanceAfter
        && after.totalSpent == before.totalSpent + d.cost
        && after.totalUnits == before.get('totalUnits', 0) + d.units
        && after.preset == before.preset
        && after.startingBalance == before.startingBalance
        && after.resetCount == before.resetCount
        && after.lastResetAt == before.lastResetAt;
    }

    // A top-up. Only to a preset amount, and at most once per 24 hours.
    function validReset(d, before, after) {
      return d.action == 'RESET_BUDGET'
        && presetAllowed(d.preset)
        && d.cost == 0 && d.baseCost == 0 && d.units == 0
        && d.balanceAfter == simPresets()[d.preset]
        && request.time > before.lastResetAt + duration.value(24, 'h')
        && after.balance == d.balanceAfter
        && after.preset == d.preset
        && after.resetCount == before.resetCount + 1
        && after.lastResetAt == request.time
        && after.startingBalance == d.balanceAfter
        && after.totalSpent == before.totalSpent
        && after.get('totalUnits', 0) == before.get('totalUnits', 0);
    }

    match /budgets/{uid} {
      allow read: if isOwner(uid) || isCoachOf(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['userId', 'preset', 'balance', 'startingBalance',
             'txCount', 'totalSpent', 'totalUnits', 'resetCount', 'lastResetAt', 'createdAt',
             'updatedAt', 'economyVersion'])
        && request.resource.data.userId == uid
        && presetAllowed(request.resource.data.preset)
        && request.resource.data.balance == simPresets()[request.resource.data.preset]
        && request.resource.data.startingBalance == request.resource.data.balance
        && request.resource.data.txCount == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.totalUnits == 0
        && request.resource.data.resetCount == 0
        && request.resource.data.lastResetAt == request.time
        && request.resource.data.createdAt == request.time;
      // Every change is one ledger row; the row's rule checks the arithmetic.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'txCount',
             'totalSpent', 'totalUnits', 'updatedAt', 'preset', 'startingBalance', 'resetCount',
             'lastResetAt'])
        && request.resource.data.txCount == resource.data.txCount + 1
        && request.resource.data.updatedAt == request.time
        && existsAfter(txPath(uid + '_' + string(request.resource.data.txCount)));
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && txId == request.auth.uid + '_' + string(request.resource.data.seq)
        && request.resource.data.transactionId == txId
        && request.resource.data.timestamp == request.time
        && request.resource.data.balanceBefore == get(budgetPath(request.auth.uid)).data.balance
        && request.resource.data.seq == get(budgetPath(request.auth.uid)).data.txCount + 1
        && getAfter(budgetPath(request.auth.uid)).data.txCount == request.resource.data.seq
        && (
          validCharge(request.resource.data,
                      get(budgetPath(request.auth.uid)).data,
                      getAfter(budgetPath(request.auth.uid)).data)
          || validReset(request.resource.data,
                        get(budgetPath(request.auth.uid)).data,
                        getAfter(budgetPath(request.auth.uid)).data)
        );
      allow update, delete: if false;
    }

    // A run exists only alongside the START_SIMULATION charge that paid for
    // it, and that charge must match the run's own stored settings.
    match /simulationRuns/{runId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.runId == runId
        && request.resource.data.modelVersion is string
        && request.resource.data.createdAt == request.time
        && getAfter(txPath(request.resource.data.startTransactionId)).data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.startTransactionId)).data.action == 'START_SIMULATION'
        && getAfter(txPath(request.resource.data.startTransactionId)).data.simulationRunId == runId
        && getAfter(txPath(request.resource.data.startTransactionId)).data.resolutionMultiplier
             == simResolutionTiers()[request.resource.data.compute.resolution]
        && getAfter(txPath(request.resource.data.startTransactionId)).data.particleMultiplier
             == simParticleTiers()[string(request.resource.data.compute.particleCount)]
        && getAfter(txPath(request.resource.data.startTransactionId)).data.nanoparticleMultiplier
             == simNanoparticleTiers()[string(request.resource.data.compute.nanoparticles)]
        && getAfter(txPath(request.resource.data.startTransactionId)).data.timeMultiplier
             == request.resource.data.parameters.durationMin;
      allow update, delete: if false;
    }

    match /simulationParameters/{runId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.runId == runId
        && getAfter(/databases/$(database)/documents/simulationRuns/$(runId)).data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /savedSimulations/{savedId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.transactionId)).data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.transactionId)).data.action == 'SAVE_SIMULATION'
        && getAfter(txPath(request.resource.data.transactionId)).data.refId == savedId;
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ---------------------------------------------------------------------
    // F2: Community Space (Posts, Comments, Reactions, Reports)
    // ---------------------------------------------------------------------
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'visible'
        && request.resource.data.commentCount == 0
        && request.resource.data.reactionCount == 0;
      allow update: if isAuthenticated() && (
        // Author editing text, media, updatedAt
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid
          && resource.data.status == 'visible')
        ||
        // Author soft-deleting or Coach/Admin moderating status
        ((resource.data.authorId == request.auth.uid || isStaff() || isAdminOrSupervisor())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['visible', 'hidden', 'removed'])
        ||
        // Updating reaction or comment counts
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'reactionCount', 'updatedAt'])
      );
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.status == 'visible';
        allow update: if isAuthenticated() && (
          (resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == request.auth.uid
            && resource.data.status == 'visible')
          ||
          ((resource.data.authorId == request.auth.uid || isStaff() || isAdminOrSupervisor())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['visible', 'hidden', 'removed'])
        );
        allow delete: if false;
      }

      match /reactions/{uid} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // Reports collection (Supports both Activity 6 filter reports & F2/F3 content reports)
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        (resource.data.get('reporterId', '') == request.auth.uid || isStaff() || isAdminOrSupervisor())
        || (resource.data.get('userId', '') == request.auth.uid || isOwner(resource.data.get('userId', '')) || isCoachOf(resource.data.get('userId', '')))
      );
      allow create: if isAuthenticated() && (
        // F2/F3 Content Report
        (request.resource.data.get('reporterId', '') == request.auth.uid
          && request.resource.data.get('targetType', '') in ['post', 'comment', 'message']
          && request.resource.data.get('resolved', false) == false)
        ||
        // Activity 6 Simulation Report
        (request.resource.data.get('userId', '') == request.auth.uid
          && getAfter(txPath(request.resource.data.transactionId)).data.userId == request.auth.uid
          && getAfter(txPath(request.resource.data.transactionId)).data.action == 'GENERATE_DETAILED_REPORT'
          && getAfter(txPath(request.resource.data.transactionId)).data.refId == reportId)
      );
      allow update: if isStaff() || isAdminOrSupervisor();
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // F3: Private Messages (Coach-Initiated Only & Admin Audit View)
    //
    // Two kinds of conversation, both started by a coach and both readable by
    // admins/supervisors for safeguarding:
    //   direct - one coach and one student (type absent on older threads);
    //   class  - a coach-moderated group chat for one class the coach teaches,
    //            id `class_<classId>`, so a class only ever has one.
    // Members may only post and update the last-message summary and unread
    // counts; only the class's coach changes who is in a class chat.
    // ---------------------------------------------------------------------
    match /conversations/{convId} {
      function summaryKeys() {
        return ['lastMessageAt', 'lastMessagePreview', 'lastSenderId', 'lastSenderName', 'unread'];
      }

      // `resource == null`: asking whether a conversation exists (a coach
      // opening a class chat for the first time) reveals nothing.
      allow read: if isAuthenticated() && (
        resource == null
        || request.auth.uid in resource.data.participantIds
        || isAdminOrSupervisor()
      );
      // CRITICAL: Only coaches can initiate a conversation
      allow create: if isTeacher()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.coachId == request.auth.uid
        && (
          (request.resource.data.get('type', 'direct') == 'direct'
            && request.resource.data.participantIds.hasAll([request.auth.uid, request.resource.data.studentId])
            && request.resource.data.participantIds.size() == 2)
          || (request.resource.data.type == 'class'
            && convId == 'class_' + request.resource.data.classId
            && teachesClass(request.resource.data.classId)
            && request.resource.data.participantIds.hasAny([request.auth.uid])
            && request.resource.data.participantIds.size() <= 80)
        );
      allow update: if isAuthenticated() && (
        isAdminOrSupervisor()
        || (request.auth.uid in resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(summaryKeys()))
        || (resource.data.get('type', 'direct') == 'class'
          && resource.data.coachId == request.auth.uid
          && teachesClass(resource.data.classId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(summaryKeys().concat(['participantIds', 'memberNames', 'title']))
          && request.resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.participantIds.size() <= 80)
      );
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          || isAdminOrSupervisor()
        );
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.deletedBySender == false
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() <= 4000
          && request.resource.data.get('attachments', []).size() <= 5;
        allow update: if isAuthenticated()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBySender'])
          && request.resource.data.deletedBySender == true;
        allow delete: if false;
      }
    }

    match /user_progress/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Leaderboards
    // ---------------------------------------------------------------------
    match /leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /bunker_leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /bangkok_bunker_leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /students/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // COACH PRIVATE NOTES: Coach-specific private observations about learners
    // ---------------------------------------------------------------------
    // Private notes remain accessible ONLY to the authoring coach.
    // Inaccessible to other coaches, learners, parents, admins, or supervisors (M5, M6).
    // Coach can only create private notes for learners in classes they teach.
    match /coachPrivate/{coachUid}/learners/{learnerId}/notes/{noteId} {
      allow read, update, delete: if isOwner(coachUid) && isTeacher();
      allow create: if isOwner(coachUid) && isTeacher() && isCoachOf(learnerId);
    }

    // ---------------------------------------------------------------------
    // COACHING RECORDS: My Learners (Coach Dashboard & Supervision)
    // ---------------------------------------------------------------------
    match /learners/{learnerId} {
      // Default deny on root doc
      allow read, write: if false;

      // 1. Check-ins: coach-only review (M1, M3, M4b, M8, M8b, M10)
      match /checkIns/{checkInId} {
        allow read: if isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 2. Agreed milestones: visible to learner and coach (M1, M4, M7, M8b)
      // Co-coaches can update milestones (e.g. mark done) but not rewrite title
      match /milestones/{milestoneId} {
        allow read: if isOwner(learnerId) || isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isCoachOf(learnerId)
          && (
            resource.data.authorUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneOn', 'updatedAt'])
          );
        allow delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 3. Coach-set goals: visible to learner and coach (M1, M4, M7, M8b)
      // Co-coaches can update coach goals (e.g. mark done) but not rewrite text
      match /coachGoals/{goalId} {
        allow read: if isOwner(learnerId) || isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isCoachOf(learnerId)
          && (
            resource.data.authorUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneOn', 'updatedAt'])
          );
        allow delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 4. Feedback on evidence: visible to learner and coach (M1, M4b, M7, M8b)
      match /feedback/{feedbackId} {
        allow read: if isOwner(learnerId) || isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 5. Competency judgements: coach-only (M1, M4b, M8, M8b, M13)
      // No judgement without evidence unless level is insufficient (M13)
      match /assessments/{assessmentId} {
        allow read: if isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid
          && (
            request.resource.data.get('level', '') == 'insufficient'
            || (request.resource.data.get('evidenceKeys', []).size() > 0)
          );
        allow update, delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 6. Coach-added evidence: visible to learner and coach (M1, M4b, M7, M8b, M14)
      // Non-empty link must be http(s) (M14)
      match /coachEvidence/{evidenceId} {
        allow read: if isOwner(learnerId) || isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid
          && (
            !('link' in request.resource.data)
            || request.resource.data.link == ''
            || request.resource.data.link.matches('^https?://.*')
          );
        allow update, delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 7. Notes for parents: coach-only draft in Firestore (M1, M4b, M8, M8b, M10)
      match /parentNotes/{noteId} {
        allow read: if isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 8. Parent reports: coach-only in Firestore; parent access is mediated via server S3 (M1, M4b, M8, M8b, M10, M11, M12)
      match /reports/{reportId} {
        allow read: if isCoachOf(learnerId) || isAdminOrSupervisor();
        allow create: if isCoachOf(learnerId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.get('status', 'draft') in ['draft', 'approved'];
        allow update: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid
          && (
            // Setting status to approved requires approvedAt (M11)
            (
              request.resource.data.get('status', '') == 'approved'
              && 'approvedAt' in request.resource.data
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'updatedAt'])
            )
            // Draft report can be updated freely as long as it remains draft
            || (
              resource.data.get('status', 'draft') != 'approved'
              && request.resource.data.get('status', 'draft') != 'approved'
            )
          );
        allow delete: if isCoachOf(learnerId)
          && resource.data.authorUid == request.auth.uid
          && resource.data.get('status', 'draft') != 'approved';
      }
    }

    // ---------------------------------------------------------------------
    // Audit trail (FERPA/COPPA). Append-only: never updatable or deletable.
    // ---------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isTeacher() || isAdminOrSupervisor();
      allow create: if isAuthenticated()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.get('source', 'client') == 'client';
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Equipment Asset Inventory (Section 3 of ASSET-INVENTORY-PLAN.md)
    // ---------------------------------------------------------------------
    function validAssetPhoto(photo, assetId) {
      return photo == null || (
        photo is map
        && photo.keys().hasOnly(['path', 'url', 'contentType', 'width', 'height', 'bytes'])
        && 'path' in photo && photo.path is string && photo.path.matches('^assets/' + assetId + '/.*')
        && (!('url' in photo) || photo.url == null || (photo.url is string && photo.url.size() <= 2048))
        && (!('contentType' in photo) || photo.contentType == null || (photo.contentType is string && photo.contentType.matches('^image/(jpeg|png|webp)$')))
        && (!('width' in photo) || photo.width == null || (photo.width is int && photo.width >= 0))
        && (!('height' in photo) || photo.height == null || (photo.height is int && photo.height >= 0))
        && (!('bytes' in photo) || photo.bytes == null || (photo.bytes is int && photo.bytes >= 0 && photo.bytes <= 5 * 1024 * 1024))
      );
    }

    function validCurrentLoan(loan) {
      return loan == null || (
        loan is map
        && loan.keys().hasOnly(['loanId', 'borrowerType', 'borrowerId', 'borrowerName', 'dueDate'])
        && 'loanId' in loan && loan.loanId is string && loan.loanId.size() > 0 && loan.loanId.size() <= 100
        && 'borrowerType' in loan && loan.borrowerType in ['coach', 'class']
        && 'borrowerId' in loan && loan.borrowerId is string && loan.borrowerId.size() > 0 && loan.borrowerId.size() <= 100
        && 'borrowerName' in loan && loan.borrowerName is string && loan.borrowerName.size() > 0 && loan.borrowerName.size() <= 120
        && (!('dueDate' in loan) || loan.dueDate == null || loan.dueDate is string || loan.dueDate is timestamp)
      );
    }

    function validAssetData(data, assetId) {
      let qtyAvail = data.get('quantityAvailable', data.quantity);
      return data.keys().hasOnly([
          'name', 'category', 'quantity', 'quantityAvailable', 'assetTag', 'serial',
          'location', 'siteId', 'condition', 'status', 'purchaseDate', 'purchaseValue',
          'currency', 'notes', 'photo', 'currentLoan', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category in ['electronics', 'robotics', 'lab', 'maker_tools', 'computers', 'av', 'sports', 'art', 'furniture', 'books', 'other']
        && data.quantity is int && data.quantity >= 1
        && qtyAvail is int && qtyAvail >= 0 && qtyAvail <= data.quantity
        && (!('assetTag' in data) || data.assetTag == null || (data.assetTag is string && data.assetTag.size() <= 40))
        && (!('serial' in data) || data.serial == null || (data.serial is string && data.serial.size() <= 80))
        && (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 80))
        && (!('siteId' in data) || data.siteId == null || (data.siteId is string && data.siteId.size() <= 50))
        && (!('condition' in data) || data.condition == null || data.condition in ['new', 'good', 'fair', 'poor'])
        && data.status in ['available', 'in_use', 'needs_repair', 'retired']
        && (!('purchaseDate' in data) || data.purchaseDate == null || (data.purchaseDate is string && data.purchaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('purchaseValue' in data) || data.purchaseValue == null || ((data.purchaseValue is int || data.purchaseValue is float || data.purchaseValue is number) && data.purchaseValue >= 0))
        && (!('currency' in data) || data.currency == null || (data.currency is string && data.currency.size() <= 10))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500))
        && (!('photo' in data) || validAssetPhoto(data.photo, assetId))
        && (!('currentLoan' in data) || validCurrentLoan(data.currentLoan));
    }

    match /assets/{assetId} {
      allow read: if isTeacher() || isAdminOrSupervisor();
      allow delete: if isAdmin();

      allow create: if isAdmin()
        && validAssetData(request.resource.data, assetId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validAssetData(request.resource.data, assetId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      match /loans/{loanId} {
        allow read: if isTeacher() || isAdminOrSupervisor();
        allow delete: if false;

        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'borrowerType', 'borrowerId', 'borrowerName', 'quantity',
            'outAt', 'outBy', 'dueDate', 'note', 'inAt', 'inBy', 'returnCondition'
          ])
          && request.resource.data.borrowerType in ['coach', 'class']
          && request.resource.data.borrowerId is string
          && request.resource.data.borrowerId.size() > 0 && request.resource.data.borrowerId.size() <= 100
          && request.resource.data.borrowerName is string
          && request.resource.data.borrowerName.size() > 0 && request.resource.data.borrowerName.size() <= 120
          && request.resource.data.quantity is int && request.resource.data.quantity >= 1
          && request.resource.data.outAt == request.time
          && request.resource.data.outBy == request.auth.uid
          && (!('dueDate' in request.resource.data) || request.resource.data.dueDate == null || request.resource.data.dueDate is string || request.resource.data.dueDate is timestamp)
          && (!('note' in request.resource.data) || request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
          && request.resource.data.get('inAt', null) == null
          && request.resource.data.get('inBy', null) == null
          && request.resource.data.get('returnCondition', null) == null
          && getAfter(/databases/$(database)/documents/assets/$(assetId)).data.quantityAvailable == get(/databases/$(database)/documents/assets/$(assetId)).data.quantityAvailable - request.resource.data.quantity
          && getAfter(/databases/$(database)/documents/assets/$(assetId)).data.quantityAvailable >= 0;

        allow update: if isAdmin()
          && resource.data.get('inAt', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inAt', 'inBy', 'returnCondition', 'note'])
          && request.resource.data.inAt == request.time
          && request.resource.data.inBy == request.auth.uid
          && request.resource.data.returnCondition in ['new', 'good', 'fair', 'poor']
          && (!('note' in request.resource.data) || request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
          && getAfter(/databases/$(database)/documents/assets/$(assetId)).data.quantityAvailable == get(/databases/$(database)/documents/assets/$(assetId)).data.quantityAvailable + resource.data.quantity;
      }
    }
  }
}
