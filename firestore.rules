rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles & subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);

      match /notes/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /progress/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /activityPreferences/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Solar Car Prototypes Collection
    match /solarCar_prototypes/{document=**} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User Progress Collection (Micro:bit Python Playground)
    match /user_progress/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Leaderboard Collection (Townsville Urban Heat Simulator)
    match /leaderboard/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Leaderboard Collection (Climate Bunker Survival Simulator)
    match /bunker_leaderboard/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Leaderboard Collection (Bangkok Coastal Bunker Challenge)
    match /bangkok_bunker_leaderboard/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Student Profiles Collection
    match /students/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }
  }
}
