rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity helpers
    // ---------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role lives in the auth token as a custom claim, not in a Firestore
    // document. Two reasons:
    //   1. A claim cannot be written by the client at all, so `role` stops being
    //      something the rules have to defend with a write guard.
    //   2. It costs zero document reads, where the old get(users/$(uid)) cost
    //      one extra read on every single rule evaluation.
    // Claims are set by scripts/grant-coach.js (Admin SDK). A user picks up a
    // new claim on their next sign-in or token refresh.
    function isTeacher() {
      return isAuthenticated() && request.auth.token.get('role', 'student') == 'teacher';
    }

    // Class ids this coach is assigned to, carried in the same claim.
    function myClassIds() {
      return request.auth.token.get('classIds', []);
    }

    // Tenancy check against a user document that is already loaded as
    // `resource` - i.e. rules on /users/{userId} itself.
    //
    // This must NOT be done with get() on /users/$(userId): during a `list`
    // operation that is a read of the very document being evaluated, and the
    // query is rejected with "Null value error". It also happens to be free,
    // where the get() form costs a document read per candidate row.
    function coachSharesClassWith(userData) {
      return isTeacher() && userData.get('classIds', []).hasAny(myClassIds());
    }

    // Same check for SUBcollection rules, where the parent user document is not
    // `resource` and genuinely has to be fetched. Costs one document read, and
    // is only ever paid on coach-initiated access.
    function isCoachOf(userId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId))
             .data.get('classIds', []).hasAny(myClassIds());
    }

    // A join code the learner typed, resolved through classCodes/{CODE}.
    //
    // This is what makes client-side enrolment safe without a backend. The
    // client cannot simply assert "add me to class X": the rule re-reads the
    // code document itself and checks it really maps to the class being joined.
    // A learner who does not know a valid code cannot produce one, and guessing
    // a classId directly fails because there is no matching code.
    function codeClassId() {
      return get(/databases/$(database)/documents/classCodes/$(request.resource.data.enrolledVia)).data.classId;
    }

    /**
     * True for exactly one safe operation: a learner adding themselves to the
     * single class their join code names, touching nothing else.
     *
     * `role` is explicitly pinned rather than merely absent from the changed
     * keys, so this path can never become a privilege escalation.
     */
    function isSelfEnrolment() {
      let before = resource.data.get('classIds', []);
      let after = request.resource.data.get('classIds', []);
      let code = request.resource.data.get('enrolledVia', '');

      return code is string
        && code.size() > 0
        && exists(/databases/$(database)/documents/classCodes/$(code))
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['classIds', 'groupName', 'enrolledVia', 'updatedAt'])
        && after.hasAll(before)
        && after.hasAny([codeClassId()])
        && after.hasOnly(before.concat([codeClassId()]));
    }

    function teachesClass(classId) {
      return isTeacher() && myClassIds().hasAny([classId]);
    }

    function inClass(classId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('classIds', []).hasAny([classId]);
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Phase 0 Admin & Reference collections (API only, client read/write false)
    // ---------------------------------------------------------------------
    match /organizations/{docId} { allow read, write: if false; }
    match /schools/{docId} { allow read, write: if false; }
    match /cohorts/{docId} { allow read, write: if false; }
    match /programmes/{docId} { allow read, write: if false; }
    match /publicIds/{docId} { allow read, write: if false; }
    match /parentLinks/{docId} { allow read, write: if false; }
    match /parentInvites/{docId} { allow read, write: if false; }

    // ---------------------------------------------------------------------
    // Join codes. classCodes/{CODE} -> { classId, className }
    //
    // Readable one document at a time by exact code, which is what a learner
    // typing a code does. Listing is denied outright: without that, a single
    // query would hand any signed-in learner every code for every class in
    // every school, which is the whole secret this collection holds.
    // ---------------------------------------------------------------------
    match /classCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow write: if false;   // issued by admin tooling only
    }

    // ---------------------------------------------------------------------
    // Classes - the tenancy unit. Created and owned by coaches.
    // ---------------------------------------------------------------------
    match /classes/{classId} {
      allow read: if teachesClass(classId) || inClass(classId);
      allow create: if isTeacher() && request.resource.data.coachIds.hasAny([request.auth.uid]);
      allow update, delete: if teachesClass(classId);
    }

    // ---------------------------------------------------------------------
    // User profiles
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Reads are limited to the owner and to coaches who share a class with that student.
      // NOTE for queries: a coach listing students MUST constrain the query,
      // e.g. .where('classIds', 'array-contains-any', myClassIds) - an
      // unconstrained collection read is rejected in full.
      allow read: if isOwner(userId) || coachSharesClassWith(resource.data);

      // New accounts are always students. Coach access is granted out-of-band
      // with the Admin SDK (scripts/grant-coach.js), which bypasses these rules.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'student') == 'student';

      // `role` may never be self-assigned - it is the privilege boundary.
      // `classIds` is the tenancy boundary and is equally closed, with one
      // narrow exception: a learner may add themselves to a class whose join
      // code they can produce.
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'orgId', 'schoolIds', 'classIds', 'status', 'publicId', 'consent', 'enrolledVia'])
        || isSelfEnrolment()
      );
      allow delete: if isOwner(userId);

      match /notes/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /progress/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /dailyStats/{docId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /activityProgress/{docId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /activityPreferences/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Coach-authored ratings on a student's work.
      match /ratings/{ratingId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isAuthenticated();
      }

      // Coach-authored feedback on student work.
      match /feedback/{feedbackId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow create, update, delete: if isAuthenticated();
      }

      // Coach notifications to students.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, delete, update: if isAuthenticated();
      }

      // Conversations between a child and the AI tutor.
      match /aiConversations/{messageId} {
        allow read: if isOwner(userId) || isCoachOf(userId);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Coach-authored coursework, scoped to a class
    // ---------------------------------------------------------------------

    match /weeklyTasks/{taskId} {
      allow read: if teachesClass(resource.data.classId) || inClass(resource.data.classId);
      allow create: if isTeacher() && teachesClass(request.resource.data.classId);
      allow update, delete: if isTeacher() && teachesClass(resource.data.classId);
    }

    match /assignments/{assignmentId} {
      allow read: if teachesClass(resource.data.classId) || inClass(resource.data.classId);
      allow create: if isTeacher() && teachesClass(request.resource.data.classId);
      allow update, delete: if isTeacher() && teachesClass(resource.data.classId);
    }

    // ---------------------------------------------------------------------
    // Student work
    // ---------------------------------------------------------------------
    match /solarCar_prototypes/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /simulations/{simulationId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.modelVersion is string
        && request.resource.data.baselineDate is string;
      allow update, delete: if false;
    }

    match /simulationResults/{resultId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      // Two shapes: v1.0 kinetic runs (many points per simulations/ doc) and
      // v1.1 filter runs (one document per simulationRuns/ doc, same id).
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          (request.resource.data.get('kind', '') != 'filterRun'
            && getAfter(/databases/$(database)/documents/simulations/$(request.resource.data.simulationId))
                 .data.userId == request.auth.uid)
          || (request.resource.data.get('kind', '') == 'filterRun'
            && resultId == request.resource.data.runId
            && get(/databases/$(database)/documents/simulationRuns/$(resultId)).data.userId == request.auth.uid)
        );
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Simulation economy (Activity 6 filter lab, SIM-COST-v1.0).
    //
    // Credits are virtual, but they are only meaningful if a learner cannot
    // mint them. There is no backend in production, so these rules are the
    // authority:
    //   - every cost is recomputed here from this price table and the
    //     multiplier tiers (src/features/activities/so2Sulfate/filter/pricing.js
    //     holds the same table; tests/sim-economy.test.js checks they match);
    //   - every ledger row is tied to exactly one budget change by a sequence
    //     number, and balanceAfter must equal balanceBefore - cost, >= 0;
    //   - the ledger is append-only and the budget cannot be deleted;
    //   - a budget can only be topped up by a reset to a preset, at most once
    //     per 24 h, and the two large presets are staff-only.
    // What a client can still do is under-declare which multiplier tier it
    // used. Every multiplier is >= 1, so no action can cost less than its base
    // price, and runs are checked against their own stored settings.
    // ---------------------------------------------------------------------
    function simPrices() {
      return {
        'START_SIMULATION': 25, 'RESET_SIMULATION': 10, 'STEP_MODE': 5,
        'FAST_FORWARD': 15, 'HIGH_RESOLUTION_SIMULATION': 50,
        'NANOPARTICLE_VIEW': 20, 'ACTIVE_SITE_VIEW': 35,
        'MOLECULAR_TRAJECTORY_TRACKING': 40, 'ADD_100_AU_NANOPARTICLES': 75,
        'INCREASE_PARTICLE_RESOLUTION': 100, 'DOUBLE_PARTICLE_COUNT': 150,
        'TEMPERATURE_SWEEP': 200, 'SO2_CONCENTRATION_SWEEP': 200,
        'FLOW_RATE_SWEEP': 175, 'CATALYST_LOADING_SWEEP': 250,
        'FULL_PARAMETER_SWEEP': 750, 'CATALYST_COMPARISON': 25,
        'GENERATE_PERFORMANCE_GRAPH': 15, 'GENERATE_DETAILED_REPORT': 50,
        'EXPORT_DATA': 25, 'EXPORT_HIGH_RES_GRAPHICS': 40,
        'SAVE_SIMULATION': 5, 'LOAD_SAVED_SIMULATION': 5
      };
    }

    // Which multipliers each action may use. Anything not listed must be 1.
    function simScales() {
      return {
        'START_SIMULATION': ['resolution', 'particles', 'time', 'nanoparticles'],
        'STEP_MODE': ['resolution', 'particles'],
        'FAST_FORWARD': ['resolution', 'particles'],
        'HIGH_RESOLUTION_SIMULATION': ['particles'],
        'NANOPARTICLE_VIEW': ['nanoparticles'],
        'MOLECULAR_TRAJECTORY_TRACKING': ['resolution'],
        'TEMPERATURE_SWEEP': ['resolution'], 'SO2_CONCENTRATION_SWEEP': ['resolution'],
        'FLOW_RATE_SWEEP': ['resolution'], 'CATALYST_LOADING_SWEEP': ['resolution'],
        'FULL_PARAMETER_SWEEP': ['resolution'], 'CATALYST_COMPARISON': ['resolution']
      };
    }

    function simPresets() {
      return { 'STUDENT': 1000, 'RESEARCHER': 10000, 'ADVANCED': 50000, 'INSTITUTION': 250000 };
    }

    function simResolutionTiers() { return { 'standard': 1, 'high': 2 }; }
    function simParticleTiers() { return { '200': 1, '400': 1.5, '800': 2, '1600': 2.5, '3200': 3 }; }
    function simNanoparticleTiers() {
      return { '100': 1, '200': 1.25, '300': 1.5, '400': 1.75, '500': 2,
               '600': 2.25, '700': 2.5, '800': 2.75, '900': 3, '1000': 3.25 };
    }

    function isStaff() {
      return isAuthenticated()
        && request.auth.token.get('role', 'student') in ['teacher', 'admin', 'supervisor'];
    }

    function presetAllowed(preset) {
      return preset in simPresets()
        && (preset in ['STUDENT', 'RESEARCHER'] || isStaff());
    }

    function scales(action, name) {
      return action in simScales() && simScales()[action].hasAny([name]);
    }

    function budgetPath(uid) {
      return /databases/$(database)/documents/budgets/$(uid);
    }

    function txPath(txId) {
      return /databases/$(database)/documents/transactions/$(txId);
    }

    // A paid action. The budget before (get) and after (getAfter) this write
    // must differ by exactly this row.
    function validCharge(d, before, after) {
      return d.action in simPrices()
        && d.baseCost == simPrices()[d.action]
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 500
        && d.resolutionMultiplier in [1, 2]
        && d.particleMultiplier in [1, 1.5, 2, 2.5, 3]
        && d.timeMultiplier is int && d.timeMultiplier >= 1 && d.timeMultiplier <= 30
        && d.nanoparticleMultiplier in [1, 1.25, 1.5, 1.75, 2, 2.25, 2.5, 2.75, 3, 3.25]
        && (d.resolutionMultiplier == 1 || scales(d.action, 'resolution'))
        && (d.particleMultiplier == 1 || scales(d.action, 'particles'))
        && (d.timeMultiplier == 1 || scales(d.action, 'time'))
        && (d.nanoparticleMultiplier == 1 || scales(d.action, 'nanoparticles'))
        && d.units == d.quantity * d.resolutionMultiplier * d.particleMultiplier
                      * d.timeMultiplier * d.nanoparticleMultiplier
        && d.cost is int
        && d.cost == math.ceil(d.baseCost * d.units)
        && d.balanceAfter == before.balance - d.cost
        && d.balanceAfter >= 0
        && after.balance == d.balanceAfter
        && after.totalSpent == before.totalSpent + d.cost
        && after.totalUnits == before.get('totalUnits', 0) + d.units
        && after.preset == before.preset
        && after.startingBalance == before.startingBalance
        && after.resetCount == before.resetCount
        && after.lastResetAt == before.lastResetAt;
    }

    // A top-up. Only to a preset amount, and at most once per 24 hours.
    function validReset(d, before, after) {
      return d.action == 'RESET_BUDGET'
        && presetAllowed(d.preset)
        && d.cost == 0 && d.baseCost == 0 && d.units == 0
        && d.balanceAfter == simPresets()[d.preset]
        && request.time > before.lastResetAt + duration.value(24, 'h')
        && after.balance == d.balanceAfter
        && after.preset == d.preset
        && after.resetCount == before.resetCount + 1
        && after.lastResetAt == request.time
        && after.startingBalance == d.balanceAfter
        && after.totalSpent == before.totalSpent
        && after.get('totalUnits', 0) == before.get('totalUnits', 0);
    }

    match /budgets/{uid} {
      allow read: if isOwner(uid) || isCoachOf(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['userId', 'preset', 'balance', 'startingBalance',
             'txCount', 'totalSpent', 'totalUnits', 'resetCount', 'lastResetAt', 'createdAt',
             'updatedAt', 'economyVersion'])
        && request.resource.data.userId == uid
        && presetAllowed(request.resource.data.preset)
        && request.resource.data.balance == simPresets()[request.resource.data.preset]
        && request.resource.data.startingBalance == request.resource.data.balance
        && request.resource.data.txCount == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.totalUnits == 0
        && request.resource.data.resetCount == 0
        && request.resource.data.lastResetAt == request.time
        && request.resource.data.createdAt == request.time;
      // Every change is one ledger row; the row's rule checks the arithmetic.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'txCount',
             'totalSpent', 'totalUnits', 'updatedAt', 'preset', 'startingBalance', 'resetCount',
             'lastResetAt'])
        && request.resource.data.txCount == resource.data.txCount + 1
        && request.resource.data.updatedAt == request.time
        && existsAfter(txPath(uid + '_' + string(request.resource.data.txCount)));
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && txId == request.auth.uid + '_' + string(request.resource.data.seq)
        && request.resource.data.transactionId == txId
        && request.resource.data.timestamp == request.time
        && request.resource.data.balanceBefore == get(budgetPath(request.auth.uid)).data.balance
        && request.resource.data.seq == get(budgetPath(request.auth.uid)).data.txCount + 1
        && getAfter(budgetPath(request.auth.uid)).data.txCount == request.resource.data.seq
        && (
          validCharge(request.resource.data,
                      get(budgetPath(request.auth.uid)).data,
                      getAfter(budgetPath(request.auth.uid)).data)
          || validReset(request.resource.data,
                        get(budgetPath(request.auth.uid)).data,
                        getAfter(budgetPath(request.auth.uid)).data)
        );
      allow update, delete: if false;
    }

    // A run exists only alongside the START_SIMULATION charge that paid for
    // it, and that charge must match the run's own stored settings.
    match /simulationRuns/{runId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.runId == runId
        && request.resource.data.modelVersion is string
        && request.resource.data.createdAt == request.time
        && getAfter(txPath(request.resource.data.startTransactionId)).data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.startTransactionId)).data.action == 'START_SIMULATION'
        && getAfter(txPath(request.resource.data.startTransactionId)).data.simulationRunId == runId
        && getAfter(txPath(request.resource.data.startTransactionId)).data.resolutionMultiplier
             == simResolutionTiers()[request.resource.data.compute.resolution]
        && getAfter(txPath(request.resource.data.startTransactionId)).data.particleMultiplier
             == simParticleTiers()[string(request.resource.data.compute.particleCount)]
        && getAfter(txPath(request.resource.data.startTransactionId)).data.nanoparticleMultiplier
             == simNanoparticleTiers()[string(request.resource.data.compute.nanoparticles)]
        && getAfter(txPath(request.resource.data.startTransactionId)).data.timeMultiplier
             == request.resource.data.parameters.durationMin;
      allow update, delete: if false;
    }

    match /simulationParameters/{runId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.runId == runId
        && getAfter(/databases/$(database)/documents/simulationRuns/$(runId)).data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /savedSimulations/{savedId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.transactionId)).data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.transactionId)).data.action == 'SAVE_SIMULATION'
        && getAfter(txPath(request.resource.data.transactionId)).data.refId == savedId;
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    match /reports/{reportId} {
      allow read: if isOwner(resource.data.userId) || isCoachOf(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.transactionId)).data.userId == request.auth.uid
        && getAfter(txPath(request.resource.data.transactionId)).data.action == 'GENERATE_DETAILED_REPORT'
        && getAfter(txPath(request.resource.data.transactionId)).data.refId == reportId;
      allow update, delete: if false;
    }

    match /user_progress/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Leaderboards
    // ---------------------------------------------------------------------
    match /leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /bunker_leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /bangkok_bunker_leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /students/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Audit trail (FERPA/COPPA). Append-only: never updatable or deletable.
    // ---------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if false;
      allow create: if isAuthenticated()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.get('source', 'client') == 'client';
      allow update, delete: if false;
    }
  }
}
