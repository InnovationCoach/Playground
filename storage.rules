rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAllowedFileType() {
      return request.resource.contentType.matches('image/jpeg')
          || request.resource.contentType.matches('image/png')
          || request.resource.contentType.matches('image/webp')
          || request.resource.contentType.matches('image/gif')
          || request.resource.contentType.matches('video/mp4')
          || request.resource.contentType.matches('video/webm')
          || request.resource.contentType.matches('video/quicktime');
    }

    function isWithinSizeLimit() {
      return request.resource.size <= 20 * 1024 * 1024; // 20 MB max
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Coach lesson uploads. Students receive temporary URLs from the scoped API.
    match /lessonMedia/{schoolId}/{offeringId}/{lessonId}/{uid}/{filename} {
      function canUploadLesson() {
        let profile = firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data : {};
        let school = firestore.exists(/databases/(default)/documents/schools/$(schoolId)) ? firestore.get(/databases/(default)/documents/schools/$(schoolId)).data : {};
        let offering = firestore.exists(/databases/(default)/documents/schools/$(schoolId)/programOfferings/$(offeringId)) ? firestore.get(/databases/(default)/documents/schools/$(schoolId)/programOfferings/$(offeringId)).data : {};
        let lesson = firestore.exists(/databases/(default)/documents/schools/$(schoolId)/programOfferings/$(offeringId)/lessons/$(lessonId)) ? firestore.get(/databases/(default)/documents/schools/$(schoolId)/programOfferings/$(offeringId)/lessons/$(lessonId)).data : {};
        let role = request.auth.token.get('role', profile.get('role', ''));
        return (role == 'admin' || role == 'coach' || role == 'teacher')
          && profile.get('status', '') != 'suspended'
          && school.get('status', '') != 'suspended'
          && (role == 'admin'
            || (schoolId in profile.get('schoolIds', []) || schoolId in request.auth.token.get('schoolIds', []) || profile.get('schoolId', '') == schoolId))
          && (role == 'admin'
            || (role in ['coach', 'teacher']
              && (lesson.get('authorUid', request.auth.uid) == request.auth.uid
                  || offering.get('createdBy', '') == request.auth.uid
                  || offering.get('classIds', []).hasAny(profile.get('classIds', []))
                  || offering.get('classIds', []).hasAny(request.auth.token.get('classIds', [])))));
      }

      allow read: if false;
      allow create, update: if isOwner(uid) && canUploadLesson()
        && request.resource != null
        && request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'video/mp4', 'video/webm', 'application/pdf', 'application/vnd.ms-powerpoint', 'application/vnd.openxmlformats-officedocument.presentationml.presentation'];
      allow delete: if isOwner(uid) && canUploadLesson();
    }

    // Program resources remain private; the scoped API issues temporary read URLs.
    match /programMedia/{schoolId}/{offeringId}/{uid}/{filename} {
      function canManageProgram() {
        let profile = firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data : {};
        let school = firestore.exists(/databases/(default)/documents/schools/$(schoolId)) ? firestore.get(/databases/(default)/documents/schools/$(schoolId)).data : {};
        let offering = firestore.exists(/databases/(default)/documents/schools/$(schoolId)/programOfferings/$(offeringId)) ? firestore.get(/databases/(default)/documents/schools/$(schoolId)/programOfferings/$(offeringId)).data : {};
        let role = request.auth.token.get('role', profile.get('role', ''));
        return (role == 'admin' || role == 'coach' || role == 'teacher')
          && profile.get('status', '') != 'suspended'
          && school.get('status', '') != 'suspended'
          && (role == 'admin'
            || (schoolId in profile.get('schoolIds', []) || schoolId in request.auth.token.get('schoolIds', []) || profile.get('schoolId', '') == schoolId))
          && (role == 'admin'
            || (role in ['coach', 'teacher']
              && (offering.get('createdBy', '') == request.auth.uid
                  || offering.get('classIds', []).hasAny(profile.get('classIds', []))
                  || offering.get('classIds', []).hasAny(request.auth.token.get('classIds', [])))));
      }

      allow read: if false;
      allow create, update: if isOwner(uid) && canManageProgram()
        && request.resource != null
        && request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp','image/gif',
          'video/mp4','video/webm','application/pdf','application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation'];
      allow delete: if isOwner(uid) && canManageProgram();
    }

    // Learner media is private. Authorized portfolio reads receive temporary URLs.
    match /learnerMedia/{uid}/{uploadId}/{filename} {
      function isLearnerActive() {
        let userDocPath = /databases/(default)/documents/users/$(uid);
        let userExists = firestore.exists(userDocPath);
        let status = userExists ? firestore.get(userDocPath).data.get('status', 'active') : 'active';
        return status != 'suspended';
      }

      allow read: if false;
      allow create, update: if isOwner(uid)
        && isLearnerActive()
        && request.resource != null
        && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp','image/gif',
          'audio/webm','audio/ogg','audio/mpeg','audio/mp4','audio/wav','video/webm','video/mp4','video/quicktime',
          'model/gltf-binary','model/gltf+json','application/octet-stream','application/zip','text/plain'];
      allow delete: if isOwner(uid) && isLearnerActive();
    }

    // F2: Community Space Media (supports 2-segment and 3-segment paths)
    match /community/{uid}/{filename} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) && isAllowedFileType() && isWithinSizeLimit();
      allow delete: if isOwner(uid);
    }
    match /community/{uid}/{postId}/{filename} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) && isAllowedFileType() && isWithinSizeLimit();
      allow delete: if isOwner(uid);
    }

    // F3: Private Message Attachments
    //
    // Only the conversation's members (and admins/supervisors, for the audit
    // view) may read them; before this, any signed-in user could. Members may
    // add images, video, voice notes and common documents, up to 20 MB each.
    // Files are never overwritten or deleted from the client.
    function isMessageFileType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          || request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          || request.resource.contentType.matches('audio/(webm|ogg|mp4|mpeg|aac|x-m4a|wav)(;.*)?')
          || request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/(msword|vnd[.]ms-excel|vnd[.]ms-powerpoint)')
          || request.resource.contentType.matches('application/vnd[.]openxmlformats-officedocument[.].*')
          || request.resource.contentType.matches('text/(plain|csv)');
    }

    function isConversationMember(convId) {
      return isAuthenticated()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(convId)).data.participantIds;
    }

    function isAuditor() {
      return isAuthenticated() && request.auth.token.get('role', 'student') in ['admin', 'supervisor'];
    }

    match /messages/{convId}/{msgId}/{filename} {
      allow read: if isConversationMember(convId) || isAuditor();
      allow create: if isConversationMember(convId) && isMessageFileType() && isWithinSizeLimit();
      allow update, delete: if false;
    }

    // Legacy / Activity uploads
    match /solarCar/{uid}/{filename} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) && isAllowedFileType() && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    // W2E Multimodal Evidence Submissions
    match /schools/{schoolId}/submissions/{submissionId}/evidence/{filename} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isWithinSizeLimit();
      allow delete: if isAuthenticated();
    }

    // Canva Exports (Private exports of learner designs)
    match /canva-exports/{ownerUid}/{filename} {
      allow read: if isOwner(ownerUid);
      allow write: if false; // written only by Admin SDK / server
    }
  }
}
