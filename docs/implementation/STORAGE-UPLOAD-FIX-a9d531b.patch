+import {MAX_MEDIA_SIZE, MEDIA_TYPES} from './personalizationModel.js';
+
+export function learnerContentType(file) {
+  const ext = file.name.split('.').at(-1).toLowerCase();
+  const mime = (file.type || '').split(';')[0].toLowerCase();
+  if (['heic', 'heif'].includes(ext) || ['image/heic', 'image/heif'].includes(mime)) {
+    throw new Error('HEIC/HEIF photos are not supported yet. Export this photo as JPEG or PNG and try again.');
+  }
+  if (ext === 'mov' || mime === 'video/quicktime') {
+    throw new Error('MOV videos are not supported yet. Export or convert this video to MP4 or WebM; changing the filename is not enough.');
+  }
+  const codeTypes = {glb:'model/gltf-binary',gltf:'model/gltf+json',obj:'text/plain',zip:'application/zip',txt:'text/plain',py:'text/plain',js:'text/plain',ts:'text/plain',json:'text/plain',html:'text/plain',css:'text/plain',ino:'text/plain'};
+  const fallback = {jpg:'image/jpeg',jpeg:'image/jpeg',png:'image/png',webp:'image/webp',gif:'image/gif',mp4:'video/mp4',webm:'video/webm',mp3:'audio/mpeg',wav:'audio/wav',m4a:'audio/mp4',ogg:'audio/ogg'};
+  const type = codeTypes[ext] || mime || fallback[ext];
+  if (!MEDIA_TYPES.includes(type)) throw new Error('Choose a supported image, audio/video reflection, code file, ZIP, GLB, glTF or OBJ.');
+  return type;
+}
+
+export function createLearnerUploader({storage, request, currentUid, uuid}) {
+  return async function upload(uid, file, kind = 'image') {
+    if (!uid || currentUid() !== uid) throw new Error('Sign in again before uploading your file.');
+    if (!file || !file.size || file.size > MAX_MEDIA_SIZE) throw new Error('Choose a file between 1 byte and 20 MB.');
+    const contentType = learnerContentType(file);
+    const name = file.name.slice(0,160), safe = name.replace(/[^A-Za-z0-9_.-]/g,'_');
+    const media = {path:`learnerMedia/${uid}/${uuid()}/${safe}`,name};
+    try { await storage.ref(media.path).put(file,{contentType}); }
+    catch (cause) {
+      const error = new Error(cause.code === 'storage/unauthorized'
+        ? 'File upload was denied. Ask your school administrator to check your active account and upload permissions.'
+        : 'File upload failed. Check your connection and try again.');
+      Object.assign(error,{code:cause.code || 'upload-failed',stage:'upload',cause});
+      throw error;
+    }
+    let discarded = false;
+    async function preview() {
+      if (discarded || currentUid() !== uid) throw new Error('This upload is no longer available. Sign in and choose the file again.');
+      try {
+        const result = await request('POST','/api/learner-space/media-preview',{body:{media,kind}});
+        if(currentUid() !== uid) throw new Error('The signed-in account changed.');
+        if (!result?.url) throw new Error('The preview service did not return a URL.');
+        return result;
+      } catch (cause) {
+        const error = new Error('File uploaded, but its private preview could not be prepared. Retry preview without uploading again, or discard the upload.');
+        Object.assign(error,{code:'preview-failed',stage:'preview',media,cause,retry:preview,discard:async()=>{
+          if (currentUid() !== uid) throw new Error('Sign in as the upload owner before discarding it.');
+          await storage.ref(media.path).delete(); discarded = true;
+        }});
+        throw error;
+      }
+    }
+    return preview();
+  };
+}
