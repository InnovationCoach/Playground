+    await assertFails(upload('hardening-owner',path,'image/png','hardening-peer'));
+    await assertFails(upload('hardening-owner',evidence+'no-school.png','image/png','hardening-owner',{...claims,schoolIds:['another-school']}));
+    await assertFails(upload('hardening-owner',evidence+'no-class.png','image/png','hardening-owner',{...claims,classIds:[]}));
+    await assertFails(upload('hardening-owner',evidence.replace('hardening-submission','nonexistent')+'photo.png'));
+    await assertSucceeds(getMetadata(ref(store('hardening-coach',{...claims,role:'coach'}),path)));
+    await assertFails(upload('hardening-coach',path,'image/png','hardening-coach',{...claims,role:'coach'}));
+    await assertSucceeds(deleteObject(ref(store('hardening-coach',{...claims,role:'coach'}),path)));
