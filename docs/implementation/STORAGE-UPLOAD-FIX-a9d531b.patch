+export function socialMediaType(file) {
+  const ext = file.name.split('.').at(-1).toLowerCase();
+  const type = (file.type || '').split(';')[0].toLowerCase();
+  if (['heic','heif'].includes(ext) || ['image/heic','image/heif'].includes(type)) {
+    throw new Error('Export HEIC/HEIF photos as JPEG or PNG before uploading.');
+  }
+  if (ext === 'mov' || type === 'video/quicktime') {
+    throw new Error('Convert MOV videos to MP4 or WebM before uploading; changing the filename is not enough.');
+  }
+  const mime = type || {jpg:'image/jpeg',jpeg:'image/jpeg',png:'image/png',webp:'image/webp',gif:'image/gif',mp4:'video/mp4',webm:'video/webm'}[ext];
+  if (!['image/jpeg','image/png','image/webp','image/gif','video/mp4','video/webm'].includes(mime)) {
+    throw new Error('Choose JPG, PNG, WebP, GIF, MP4 or WebM.');
+  }
+  if (!file.size || file.size > 20*1024*1024) throw new Error('Choose an image or video between 1 byte and 20 MB.');
+  return mime;
+}
+
+export async function putSocialMedia(storageRef,file,metadata={}) {
+  const contentType=socialMediaType(file);
+  try {await storageRef.put(file,{contentType,...metadata});}
+  catch(cause){
+    const error=new Error(cause.code==='storage/unauthorized'
+      ? 'Image/video upload was denied. Check your account and attachment permissions with your school administrator.'
+      : 'Image/video upload failed. Check your connection and try again.');
+    Object.assign(error,{code:cause.code,stage:'upload',cause});throw error;
+  }
+  try {return {url:await storageRef.getDownloadURL(),contentType};}
+  catch(cause){throw new Error('The file uploaded, but its attachment URL could not be retrieved. Please try again.');}
+}
