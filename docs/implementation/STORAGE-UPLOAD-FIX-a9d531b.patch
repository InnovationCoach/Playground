+    expect(learnerContentType({...file,type:''})).toBe('image/png');
+    expect(learnerContentType({name:'video.webm',type:'video/webm;codecs=vp9'})).toBe('video/webm');
+  });
+  it('reports permission failure at upload stage without calling preview',async()=>{
+    const t=setup();t.put.mockRejectedValue({code:'storage/unauthorized'});
+    await expect(t.upload('owner',file)).rejects.toMatchObject({stage:'upload',code:'storage/unauthorized'});
+    expect(t.request).not.toHaveBeenCalled();
+  });
+  it('retains uploaded path and retries preview without uploading twice',async()=>{
+    const t=setup();t.request.mockRejectedValueOnce(new Error('signBlob denied'));
+    const error=await t.upload('owner',file).catch(e=>e);
+    expect(error).toMatchObject({stage:'preview',media:{path:'learnerMedia/owner/id/photo.png'}});
+    await expect(error.retry()).resolves.toHaveProperty('url');
+    expect(t.put).toHaveBeenCalledTimes(1);expect(t.request).toHaveBeenCalledTimes(2);
+    expect(t.request.mock.calls[1][2].body.media).toEqual(error.media);
+  });
+  it('treats empty URLs as preview failure and discards only the uploaded object',async()=>{
+    const t=setup();t.request.mockResolvedValue({url:''});
+    const error=await t.upload('owner',file).catch(e=>e);
+    expect(error.code).toBe('preview-failed');await error.discard();expect(t.remove).toHaveBeenCalledTimes(1);
+    await expect(error.retry()).rejects.toThrow('no longer available');
+  });
+  it('prevents uploading or retrying/discarding after account changes',async()=>{
+    const t=setup();t.request.mockRejectedValue(new Error('offline'));
+    const error=await t.upload('owner',file).catch(e=>e);t.signOut();
+    await expect(error.retry()).rejects.toThrow('no longer available');
+    await expect(error.discard()).rejects.toThrow('owner');
+    await expect(t.upload('owner',file)).rejects.toThrow('Sign in again');
+    expect(t.put).toHaveBeenCalledTimes(1);expect(t.remove).not.toHaveBeenCalled();
+  });
+});
+
+describe('Community and message upload validation',()=>{
+  it('validates phone formats and size before sending bytes',async()=>{
+    const storageRef={put:vi.fn(),getDownloadURL:vi.fn()};
+    await expect(putSocialMedia(storageRef,{...file,name:'phone.heic',type:'image/heic'})).rejects.toThrow('Export HEIC');
+    await expect(putSocialMedia(storageRef,{...file,name:'phone.mov',type:'video/quicktime'})).rejects.toThrow('Convert MOV');
+    await expect(putSocialMedia(storageRef,{...file,size:21*1024*1024})).rejects.toThrow('20 MB');
+    expect(storageRef.put).not.toHaveBeenCalled();
+    expect(socialMediaType({...file,type:''})).toBe('image/png');
+  });
+  it('sends signed-in owner metadata and normalized MIME for attachments',async()=>{
+    const storageRef={put:vi.fn().mockResolvedValue({}),getDownloadURL:vi.fn().mockResolvedValue('https://example.test/image')};
+    await expect(putSocialMedia(storageRef,file,{customMetadata:{ownerUid:'owner'}})).resolves.toMatchObject({contentType:'image/png'});
+    expect(storageRef.put).toHaveBeenCalledWith(file,{contentType:'image/png',customMetadata:{ownerUid:'owner'}});
+  });
+  it('distinguishes upload denial from URL retrieval failure',async()=>{
+    const storageRef={put:vi.fn().mockRejectedValue({code:'storage/unauthorized'}),getDownloadURL:vi.fn()};
+    await expect(putSocialMedia(storageRef,file)).rejects.toMatchObject({stage:'upload'});
+    expect(storageRef.getDownloadURL).not.toHaveBeenCalled();
+    storageRef.put.mockResolvedValue({});storageRef.getDownloadURL.mockRejectedValue(new Error('denied'));
+    await expect(putSocialMedia(storageRef,file)).rejects.toThrow('file uploaded');
+  });
+});
