+}
+const file={name:'photo.png',size:3,type:'image/png'};
+describe('Private learner upload recovery',()=>{
+  it('gives explicit phone format guidance before any upload',async()=>{
+    const t=setup();
+    for(const [name,type] of [['photo.heic','image/heic'],['photo.heif',''],['movie.mov','video/quicktime']])await expect(t.upload('owner',{...file,name,type})).rejects.toThrow(/Export|convert/);
+    expect(t.put).not.toHaveBeenCalled();
