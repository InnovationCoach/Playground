+import {readFileSync} from 'node:fs';
+import {beforeAll,afterAll,describe,it} from 'vitest';
+import {initializeTestEnvironment,assertSucceeds,assertFails} from '@firebase/rules-unit-testing';
+import {doc,setDoc,updateDoc} from 'firebase/firestore';
+import {ref,uploadBytes,getMetadata,deleteObject} from 'firebase/storage';
+
+describe('Media identity and tenant isolation',()=>{
+  let env;
+  const claims={role:'student',schoolIds:['hardening-school'],classIds:['hardening-class']};
+  const evidence='schools/hardening-school/programOfferings/hardening-offering/submissions/hardening-submission/evidence/';
+  const store=(uid,c=claims)=>env.authenticatedContext(uid,c).storage();
+  const upload=(uid,path,type='image/png',ownerUid=uid,c=claims)=>uploadBytes(ref(store(uid,c),path),new Uint8Array([1,2,3]),{contentType:type,customMetadata:{ownerUid}});
+  beforeAll(async()=>{
+    env=await initializeTestEnvironment({projectId:'demo-hearisland-local',firestore:{host:'127.0.0.1',port:8088,rules:readFileSync('firestore.rules','utf8')},storage:{host:'127.0.0.1',port:9199,rules:readFileSync('storage.rules','utf8')}});
+    await env.withSecurityRulesDisabled(async ctx=>{
+      const db=ctx.firestore();
+      for(const uid of ['hardening-owner','hardening-peer','hardening-outsider'])await setDoc(doc(db,'users',uid),{...claims,status:'active'});
+      await setDoc(doc(db,'users','hardening-coach'),{...claims,role:'coach',status:'active'});
+      await setDoc(doc(db,'users','hardening-admin'),{role:'admin',status:'active'});
+      for(const [uid,status] of [['hardening-pending','pending'],['hardening-unknown','mystery'],['hardening-missing-status',null]])await setDoc(doc(db,'users',uid),status?{status}:{});
+      await setDoc(doc(db,'conversations','hardening-conv'),{participantIds:['hardening-owner','hardening-peer']});
+      await setDoc(doc(db,'schools','hardening-school'),{status:'active'});
+      await setDoc(doc(db,'schools','hardening-school','programOfferings','hardening-offering'),{classIds:['hardening-class']});
+      await setDoc(doc(db,'schools','hardening-school','programOfferings','hardening-offering','submissions','hardening-submission'),{learnerUid:'hardening-owner',classId:'hardening-class'});
+    });
+  });
+  afterAll(async()=>env?.cleanup());
+  it('rejects missing, pending, unknown and missing-status learner profiles',async()=>{
+    for(const uid of ['hardening-nonexistent','hardening-pending','hardening-unknown','hardening-missing-status'])await assertFails(upload(uid,`learnerMedia/${uid}/id/photo.png`));
+  });
+  it('permits owner MP4 but rejects MOV/HEIC and private direct reads',async()=>{
+    const path='learnerMedia/hardening-owner/id/video.mp4';
+    await assertSucceeds(upload('hardening-owner',path,'video/mp4'));
+    await assertFails(getMetadata(ref(store('hardening-owner'),path)));
+    for(const type of ['video/quicktime','image/heic','image/heif'])await assertFails(upload('hardening-owner',`learnerMedia/hardening-owner/id/${type.replace('/','-')}`,type));
+  });
+  for(const suffix of ['attachment.png','msg-id/attachment.png']){
+    it(`protects conversation ownership for ${suffix}`,async()=>{
+      const path=`messages/hardening-conv/${suffix}`;
+      await assertFails(upload('hardening-outsider',path));
+      await assertFails(upload('hardening-owner',path,'image/png','hardening-peer'));
+      await assertSucceeds(upload('hardening-owner',path));
+      await assertSucceeds(getMetadata(ref(store('hardening-peer'),path)));
+      await assertFails(getMetadata(ref(store('hardening-outsider'),path)));
+      await assertFails(upload('hardening-peer',path));
+      await assertFails(deleteObject(ref(store('hardening-peer'),path)));
+      await assertFails(upload('hardening-owner',path,'image/png','hardening-peer'));
+      await assertSucceeds(upload('hardening-owner',path,'video/mp4'));
+      await assertSucceeds(deleteObject(ref(store('hardening-owner'),path)));
+    });
+  }
