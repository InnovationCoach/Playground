+++ b/docs/implementation/programs-library/firestore.rules.proposed
@@ -527,6 +527,15 @@ service cloud.firestore {
         allow delete: if isAuthenticated() && canWriteCoachRecord(userId) && resource.data.coachId == request.auth.uid;
       }
 
