{
  "name": "welearn-functions",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:@google-cloud/* --external:@google/generative-ai --external:cors --external:dotenv --external:express --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/*"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
