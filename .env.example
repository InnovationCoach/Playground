# Copy to .env and fill in. NEVER commit a real .env - see SECURITY note below.
#
# SECURITY: .env.local was committed in the initial commit (27e9d6a) and the
# Gemini API key in it must be treated as public and rotated. The Firebase web
# config below is NOT a secret - it is a public client identifier, and access is
# controlled by firestore.rules, not by hiding this value.

# --- Server (never exposed to the browser) ---
# The Gemini key lives ONLY here. It is read by server/gemini-index.js.
GEMINI_API_KEY=

# Firebase Admin credentials for token verification and the safeguarding
# transcript. Either point at a service-account key file, or leave unset on
# Cloud Run / App Hosting where the runtime service account is used.
# GOOGLE_APPLICATION_CREDENTIALS=./scripts/firebase-admin-key.json

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Client ---
# Only VITE_-prefixed vars reach the browser, and every one of them is INLINED
# into the public bundle at build time. Never put a secret here.
# Leave VITE_API_URL empty: the app calls same-origin /api, which Hosting
# rewrites to the backend and the Vite dev server proxies to :3001. Setting it
# to http://localhost:3001 bakes localhost into production builds.
VITE_API_URL=


# Local review against the Firebase emulators is enabled in the browser, not
# here: load http://localhost:5173/?emulators=1 (and ?emulators=0 to turn it
# off). The choice is stored per browser so it can never leak into a build.
